  "claims": [
    {
      "id": "claim_feccd673311d4343a6dcef219b20d16d",
      "statement": "The public bars package exposes vectorized tick, volume, dollar, and volume-imbalance samplers under the default names, preserves loop-based versions under `Original` suffixes, and exports fixed, window-based, and run variants directly.",
      "evidence": [
        {
          "resource": "repo://src/ml4t/engineer/bars/__init__.py#L20-L88",
          "version": "repo-lines-v1:sha256:195e109b3c385549e057e90bc8c47c572e558a381f3a8d00d4bd9a519aa70909:"
        }
      ]
    },
    {
      "id": "claim_6e46093a1dee45c887f3f1f8d64fdfa1",
      "statement": "All bar samplers share validation that requires a Polars DataFrame with non-null sorted Datetime timestamps, finite positive numeric prices, and finite nonnegative numeric volumes; a supplied side column must contain only non-null numeric -1 or +1 values.",
      "evidence": [
        {
          "resource": "repo://src/ml4t/engineer/bars/base.py#L35-L100",
          "version": "repo-lines-v1:sha256:ac78ef418f7a0adfa134652f464fd1c453ae71dc6248f29b252b54af3c9114e2:"
